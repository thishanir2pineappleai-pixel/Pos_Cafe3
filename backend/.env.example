# POS Cafe backend (development only). Copy to .env to override the defaults shown here.
PORT=4000
# HOST must stay a loopback address; the server refuses to start otherwise.
HOST=127.0.0.1
# Comma-separated list of allowed browser origins (the local Vite dev server).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Signs access tokens and keys the one-time-code hashes. At least 32 random characters, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If it is missing in development a temporary key is used and every sign-in ends when the server restarts.
# It is REQUIRED when NODE_ENV=production. Never commit a real value (.env is ignored by Git).
JWT_SECRET=

# How verification codes and access keys leave the server:
#   none        (default) nothing is sent: no email or SMS provider is configured yet
#   dev-outbox  local testing only: messages (with the raw codes) are kept in memory and shown at GET /api/v1/dev/outbox.
#               Refused when NODE_ENV=production.
MESSAGE_DELIVERY=none

# ---- Storage: MySQL through Prisma (microservices only; the old backend on port 4000 has no database) ----
# memory (default): data is lost when a service restarts. prisma: data is stored in MySQL. NODE_ENV=production requires prisma.
# A service started with prisma and a missing/invalid URL refuses to start; it never falls back to memory.
REPOSITORY_DRIVER=memory

# ONE MySQL server, FOUR logical databases (created by backend/database/create-databases.sql, run by you as a MySQL
# administrator). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE. Replace CHANGE_ME with your own password in your
# private backend/.env only, never in this file. Percent-encode special characters in the password (@ -> %40, : -> %3A,
# / -> %2F, # -> %23, % -> %25).
AUTH_DATABASE_URL=mysql://pos_auth_app:CHANGE_ME@127.0.0.1:3306/pos_auth_db
SETTINGS_DATABASE_URL=mysql://pos_settings_app:CHANGE_ME@127.0.0.1:3306/pos_settings_db
STAFF_DATABASE_URL=mysql://pos_staff_app:CHANGE_ME@127.0.0.1:3306/pos_staff_db
MENU_DATABASE_URL=mysql://pos_menu_app:CHANGE_ME@127.0.0.1:3306/pos_menu_db

# Only `prisma migrate dev` (creating a NEW migration during development) needs these scratch databases.
# `prisma migrate deploy` does not, and neither does running the services.
# AUTH_SHADOW_DATABASE_URL=mysql://pos_auth_app:CHANGE_ME@127.0.0.1:3306/pos_auth_db_shadow
# SETTINGS_SHADOW_DATABASE_URL=mysql://pos_settings_app:CHANGE_ME@127.0.0.1:3306/pos_settings_db_shadow
# STAFF_SHADOW_DATABASE_URL=mysql://pos_staff_app:CHANGE_ME@127.0.0.1:3306/pos_staff_db_shadow
# MENU_SHADOW_DATABASE_URL=mysql://pos_menu_app:CHANGE_ME@127.0.0.1:3306/pos_menu_db_shadow

# Repository tests against MySQL. Keep these OUT of backend/.env (set them in one terminal only): those tests EMPTY the
# tables of the database they point at, and refuse any database whose name does not end in _test.
# AUTH_TEST_DATABASE_URL=mysql://pos_auth_app:CHANGE_ME@127.0.0.1:3306/pos_auth_db_test
# SETTINGS_TEST_DATABASE_URL=mysql://pos_settings_app:CHANGE_ME@127.0.0.1:3306/pos_settings_db_test
# STAFF_TEST_DATABASE_URL=mysql://pos_staff_app:CHANGE_ME@127.0.0.1:3306/pos_staff_db_test
# MENU_TEST_DATABASE_URL=mysql://pos_menu_app:CHANGE_ME@127.0.0.1:3306/pos_menu_db_test

# ---- Microservices (gateway/ and services/*) ----
# Every service reads this file after its own .env. These two values MUST be the same for all services, so set them HERE.
# (The old backend ignores INTERNAL_SERVICE_KEY.)

# Protects the service-to-service endpoints (/internal/*) and is sent with every internal call. At least 32 random
# characters, for example the output of:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Without it, each service invents its own temporary key, so services cannot confirm sessions (503). REQUIRED in production.
INTERNAL_SERVICE_KEY=
# (JWT_SECRET above must also be the same for every service: services verify tokens locally with it.)










# API Gateway (development). Copy to .env (git ignores it) only to override the defaults below.
# The Gateway holds no secrets: it never needs JWT_SECRET or INTERNAL_SERVICE_KEY.

# Port the frontend calls. The old backend still uses 4000 during the migration, so the Gateway defaults to 4100.
GATEWAY_PORT=4100
# HOST must stay a loopback address; the Gateway refuses to start otherwise.
HOST=127.0.0.1
# Comma-separated list of browser origins allowed to call the Gateway (the local Vite dev server).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where each internal service listens (full URL, no path).
AUTH_SERVICE_URL=http://127.0.0.1:4001
SETTINGS_SERVICE_URL=http://127.0.0.1:4002
STAFF_SERVICE_URL=http://127.0.0.1:4003
MENU_SERVICE_URL=http://127.0.0.1:4004

# How long a service may take to answer before the Gateway answers 504, in milliseconds.
UPSTREAM_TIMEOUT_MS=15000
# Requests allowed per client IP per minute before the Gateway answers 429.
GATEWAY_RATE_LIMIT_PER_MINUTE=600
# Largest request body (Content-Length) the Gateway forwards, in bytes (uploads included).
GATEWAY_MAX_BODY_BYTES=10485760
